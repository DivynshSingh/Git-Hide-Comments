#!/usr/bin/env python3
"""
git-hc entry point script.
"""

import sys
import os

_HERE = os.path.dirname(os.path.realpath(__file__))
# Check local src/ first (for dev repo execution)
_local_src = os.path.join(_HERE, 'src')
if os.path.isdir(_local_src) and _local_src not in sys.path:
    sys.path.insert(0, _local_src)

from hc.cli import main

if __name__ == '__main__':
    main()
